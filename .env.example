# ---------------------------------------------------------------------------
# Travel Assistance AI Platform — environment configuration
# Copy to `.env` and adjust. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# Local development (docker-compose.dev.yml exposes Postgres on host port 5434):
DATABASE_URL=postgresql://taap:taap_dev_password@localhost:5434/taap?schema=public

# Optional Anthropic API key. When set, AI features use the live Claude API.
# When empty, the platform runs on the built-in deterministic demo AI provider
# (fully offline, suitable for demos without external dependencies).
AI_API_KEY=

# Claude model used when AI_API_KEY is set.
AI_MODEL=claude-opus-5-5

# Artificial "thinking" delay of the offline AI provider, in ms (0 = none).
MOCK_AI_LATENCY_MS=450

# Public base URL of the application (used in links and health reporting).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Directory where uploaded documents are stored (mounted as a volume in Docker).
UPLOAD_DIR=./uploads

# Maximum upload size in megabytes.
MAX_UPLOAD_MB=10

# --- Voice agents (xAI Grok Voice) ----------------------------------------
# Without XAI_API_KEY the voice features are unavailable; everything else works.
XAI_API_KEY=
# Pinned (not grok-voice-latest) so xAI auto-migrations can't change behaviour.
XAI_VOICE_MODEL=grok-voice-3.0
# Development only: where browsers reach the gateway (npm run dev:gateway).
# Leave empty in production — nginx serves it on the same origin under /ws/.
VOICE_GATEWAY_PUBLIC_URL=ws://localhost:8080
# Secret shared by the app and the gateway for session tickets (defaults to SESSION_SECRET).
GATEWAY_SECRET=
# Development only: how the app reaches the gateway (compose uses http://voice-gateway:8080).
VOICE_GATEWAY_INTERNAL_URL=http://localhost:8080

# --- Telephony (Twilio) ------------------------------------------------------
# Without these, phone features are off; browser voice still works.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=           # the hotline / caller ID, E.164 (+15550100199)
ON_CALL_DOCTOR_NUMBER=         # emergencies are warm-transferred here
CASE_MANAGER_NUMBER=           # "I want to speak to a person" goes here
# Comma-separated E.164 numbers outbound AI calls may dial. Nothing else can be called.
OUTBOUND_ALLOWED_NUMBERS=
OUTBOUND_RETRY_MINUTES=30          # unanswered calls are retried once
MAX_CONCURRENT_CALLS=5
CALL_DATA_RETENTION_DAYS=30        # phone transcripts are erased after this
HOTLINE_AGENT=inbound-hotline

# --- E-mail & fax intake, Letters of Guarantee ------------------------------
# Outbound e-mail: Amazon SES over SMTP (as in CareTrack) when all five
# SES_* values below are set, else SendGrid, else nothing leaves the server
# and messages are only recorded in the outbox. Mail to the demo's fictional
# addresses (example.com, *.example) is never handed to a real provider.
# SES_SMTP_USER / SES_SMTP_PASSWORD are SES SMTP credentials, not an IAM key
# pair; the sender must be on an identity those credentials may send as.
SES_SMTP_HOST=                     # email-smtp.ap-south-1.amazonaws.com
SES_SMTP_PORT=                     # 587
SES_SMTP_USER=
SES_SMTP_PASSWORD=
SES_MAIL_FROM=                     # e.g. noreply@caretrack.info
SES_MAIL_FROM_NAME=CareTrail
FOLLOW_UP_REPLY_TO=                # where visitors' replies to meeting follow-ups go, e.g. a presenter's own mailbox
SENDGRID_API_KEY=
EMAIL_FROM=                        # a verified SendGrid sender
# Secret path segments of the inbound webhooks (openssl rand -hex 24):
#   /api/inbound/email/<INBOUND_EMAIL_SECRET>, /api/inbound/fax/<INBOUND_FAX_SECRET>
INBOUND_EMAIL_SECRET=
INBOUND_FAX_SECRET=
LOG_AUTO_APPROVE_LIMIT=10000       # EUR; larger guarantees wait for a person
LOG_VALID_DAYS=7

# --- Teams calls proposed from a quotation (Microsoft Graph) ----------------
# An Entra app with the application permission Calendars.ReadWrite, limited in
# Exchange Online to the organiser's mailbox; the invite goes from that
# mailbox's Outlook calendar. All four set, or the quotation offers no call.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MEETING_ORGANIZER=              # e.g. rajdeep.shah@sthiramservices.com

# Operator sign-in. Leave both empty to disable sign-in (local development).
# Add operators with: ./scripts/add-operator.sh <name>  (or npm run auth:hash)
OPERATOR_USERS=
SESSION_SECRET=

# --- Production-only (docker-compose.yml) -----------------------------------
# Credentials for the PostgreSQL container in production.
POSTGRES_USER=taap
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=taap

# Public HTTPS hostname. Setting DOMAIN makes deploy.sh enable the "tls"
# profile: certbot obtains a Let's Encrypt certificate and nginx serves HTTPS.
DOMAIN=
LETSENCRYPT_EMAIL=
# Externally reachable base URL (Twilio webhooks are validated against it).
PUBLIC_BASE_URL=

# Days of nightly database dumps kept on the host (backup service).
BACKUP_RETENTION_DAYS=7
