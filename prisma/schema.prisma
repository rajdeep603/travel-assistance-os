generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// All data in this schema is FICTIONAL demo data for the ITIC Global
// demonstration platform. It must never hold real patient information.
// ---------------------------------------------------------------------------

enum CaseStatus {
  NEW
  IN_PROGRESS
  PENDING_INFO
  ESCALATED
  RESOLVED
  CLOSED
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssistanceType {
  MEDICAL
  DENTAL
  HOSPITALIZATION
  EVACUATION
  REPATRIATION
  GENERAL
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ClaimStatus {
  SUBMITTED
  PROCESSING
  NEEDS_REVIEW
  INFO_REQUESTED
  APPROVED
  ESCALATED
  REJECTED
  PAID
}

enum DocumentKind {
  MEDICAL_REPORT
  HOSPITAL_INVOICE
  PRESCRIPTION
  DISCHARGE_SUMMARY
  COST_ESTIMATE
  GUARANTEE_LETTER
  CORRESPONDENCE
  EXPLANATION_OF_BENEFITS
  OTHER
}

enum DocumentSource {
  UPLOAD
  EMAIL
  FAX
  WHATSAPP
  GENERATED
}

enum MessageChannel {
  EMAIL
  FAX
  SMS
  WHATSAPP
}

enum InboundStatus {
  RECEIVED
  PROCESSING
  MATCHED
  NEEDS_REVIEW
  REPLIED
  FAILED
}

enum OutboundStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
}

enum ConversationChannel {
  VOICE
  CHAT
  ASSISTANT
  PHONE
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallChannel {
  PHONE
  BROWSER
}

enum CallStatus {
  QUEUED
  RINGING
  IN_PROGRESS
  COMPLETED
  TRANSFERRED
  VOICEMAIL
  NO_ANSWER
  BUSY
  FAILED
  CANCELED
}

enum CaseEventType {
  CALL
  EMAIL
  FAX
  WHATSAPP
  HANDOFF
  LETTER_OF_GUARANTEE
  NOTE
  STATUS
  APPOINTMENT
  DOCUMENT
  CLAIM
  BILL_REVIEW
  TRANSPORT
}

model Patient {
  id           String        @id @default(cuid())
  ref          String        @unique // e.g. PAT-1001
  firstName    String
  lastName     String
  dateOfBirth  DateTime
  nationality  String
  language     String
  phone        String
  email        String
  policyNumber String        @unique
  policy       Policy?
  createdAt    DateTime      @default(now())
  cases        Case[]
  appointments Appointment[]
  claims       Claim[]
  documents    Document[]
}

model Case {
  id               String            @id @default(cuid())
  ref              String            @unique // e.g. CASE-1024
  title            String
  description      String
  location         String
  country          String            @default("Turkiye")
  assistanceType   AssistanceType    @default(MEDICAL)
  priority         CasePriority      @default(MEDIUM)
  status           CaseStatus        @default(NEW)
  urgency          String?
  symptoms         String[]
  aiSummary        String?
  suggestedActions Json?
  assignedTo       String?
  patient          Patient           @relation(fields: [patientId], references: [id])
  patientId        String
  appointments     Appointment[]
  claims           Claim[]
  documents        Document[]
  conversations    Conversation[]
  calls            Call[]
  events           CaseEvent[]
  inboundMessages  InboundMessage[]
  outboundMessages OutboundMessage[]
  guaranteeLetters GuaranteeLetter[]
  billReviews      BillReview[]
  transportPlans   TransportPlan[]
  handoffs         CaseHandoff[]
  /// The assistance company handling the case for the insurer (insurer oversight); null when we handle it ourselves.
  vendor           NetworkPartner?   @relation("CaseVendor", fields: [vendorId], references: [id])
  vendorId         String?
  // The relative kept informed (e.g. the daughter who called), and whether
  // updates go to them automatically at each step.
  familyContactName     String?
  familyContactRelation String?
  familyContactPhone    String?
  familyContactLanguage String?
  familyUpdates         Boolean  @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([patientId])
  @@index([vendorId])
}

enum ProviderKind {
  CLINIC
  HOSPITAL
  TELEMEDICINE
  AIR_AMBULANCE
  GROUND_AMBULANCE
}

model Provider {
  id               String            @id @default(cuid())
  ref              String            @unique // e.g. PRV-2001
  name             String // doctor name
  facility         String
  specialty        String
  address          String
  district         String
  city             String
  country          String            @default("Turkiye")
  latitude         Float
  longitude        Float
  languages        String[]
  phone            String
  email            String
  rating           Float             @default(4.5)
  // Weekly template of Istanbul wall-clock slots: { mon: ["09:00", ...], ... }
  availability     Json
  kind             ProviderKind      @default(CLINIC)
  /// Accreditations and licences shown on the provider: "JCI", "ISO 9001", "EURAMI", …
  accreditations   String[]          @default([])
  /// Negotiated network rates over the reference tariff (src/lib/services/provider-network.ts): { name, multiplier?, perCode? }.
  rateCard         Json?
  /// Names and spellings this record had in duplicates that were merged into it.
  aliases          String[]          @default([])
  /// Set when this record was a duplicate merged into another one: it no longer appears in search.
  mergedInto       Provider?         @relation("ProviderMerge", fields: [mergedIntoId], references: [id])
  mergedIntoId     String?
  mergedFrom       Provider[]        @relation("ProviderMerge")
  createdAt        DateTime          @default(now())
  appointments     Appointment[]
  guaranteeLetters GuaranteeLetter[]

  @@index([mergedIntoId])
}

/// A network clean-up: a duplicate provider merged into the record kept, with
/// everything that moved, so it can be undone and audited.
model ProviderMerge {
  id        String    @id @default(cuid())
  keptId    String
  removedId String
  /// { appointments: string[], guaranteeLetters: string[], languages: string[], aliases: string[] } moved onto the kept record
  moved     Json
  reasons   String[]
  score     Float
  mergedBy  String
  undoneAt  DateTime?
  undoneBy  String?
  createdAt DateTime  @default(now())

  @@index([keptId])
  @@index([createdAt])
}

model Appointment {
  id          String            @id @default(cuid())
  ref         String            @unique // e.g. APT-2026-1024
  scheduledAt DateTime
  status      AppointmentStatus @default(PENDING)
  reason      String
  notes       String?
  source      String            @default("WEB") // WEB | VOICE
  patient     Patient           @relation(fields: [patientId], references: [id])
  patientId   String
  provider    Provider          @relation(fields: [providerId], references: [id])
  providerId  String
  case        Case?             @relation(fields: [caseId], references: [id])
  caseId      String?
  createdAt   DateTime          @default(now())

  // Also enforced by a partial unique index (migration
  // 20261015120000_ref_sequences_booking_integrity): one PENDING/CONFIRMED
  // appointment per provider slot.
  @@index([providerId, scheduledAt, status])
  @@index([patientId])
  @@index([caseId])
}

model Claim {
  id          String       @id @default(cuid())
  ref         String       @unique // e.g. CLM-10245
  status      ClaimStatus  @default(SUBMITTED)
  amount      Decimal?     @db.Decimal(12, 2)
  currency    String?
  summary     String?
  aiSource    String? // which provider wrote the summary: "claude" | "offline"
  // Array of { severity: "error" | "ok" | "warning", message: string }.
  // Travellers see these (voice agent, upload page): never put integrity signals here.
  issues      Json?
  // Internal integrity signals (fraud, waste and abuse): Array of { code, level, reason }
  signals     Json?
  history     Json? // Array of { at, action, note }
  // The settlement a person approved (src/lib/services/settlement.ts): what the plan pays, what the traveller pays, and why
  settlement  Json?
  // The explanation of benefits sent with the settlement (a generated Document)
  eobDocumentId String?
  patient     Patient      @relation(fields: [patientId], references: [id])
  patientId   String
  case        Case?        @relation(fields: [caseId], references: [id])
  caseId      String?
  documents   Document[]
  billReviews BillReview[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([patientId])
  @@index([caseId])
}

model Document {
  id               String              @id @default(cuid())
  filename         String
  mimeType         String
  sizeBytes        Int
  kind             DocumentKind        @default(OTHER)
  status           DocumentStatus      @default(UPLOADED)
  storagePath      String?
  textContent      String?
  error            String?
  patient          Patient?            @relation(fields: [patientId], references: [id])
  patientId        String?
  case             Case?               @relation(fields: [caseId], references: [id])
  caseId           String?
  claim            Claim?              @relation(fields: [claimId], references: [id])
  claimId          String?
  extraction       DocumentExtraction?
  source           DocumentSource      @default(UPLOAD)
  // ISO 639-1 language of the text (detected), e.g. "en", "tr"
  language         String?
  // English translation, when the original isn't English
  translatedText   String?
  // Text came from OCR (scanned / faxed / handwritten) rather than a text layer
  ocr              Boolean             @default(false)
  inboundMessage   InboundMessage?     @relation(fields: [inboundMessageId], references: [id])
  inboundMessageId String?
  billReview       BillReview?
  createdAt        DateTime            @default(now())

  @@index([claimId])
  @@index([caseId])
  @@index([inboundMessageId])
}

model DocumentExtraction {
  id              String   @id @default(cuid())
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId      String   @unique
  patientName     String?
  dateOfBirth     String?
  hospital        String?
  doctor          String?
  diagnosis       String?
  symptoms        String[]
  admissionDate   String?
  dischargeDate   String?
  procedures      String[]
  medications     String[]
  invoiceAmount   Decimal? @db.Decimal(12, 2)
  currency        String?
  policyReference String?
  // Invoice, estimate or fatura number
  documentNumber  String?
  // Charge rows: Array of { code, description, quantity, unitPrice, amount }
  lineItems       Json?
  summary         String?
  missingInfo     String[]
  confidence      Float?
  aiSource        String? // "claude" | "offline"
  raw             Json?
  createdAt       DateTime @default(now())

  @@index([documentNumber])
}

model Conversation {
  id        String              @id @default(cuid())
  channel   ConversationChannel
  // Array of { role: "user" | "agent", text: string, at: ISO string }
  messages  Json
  // Voice agent dialog state machine snapshot
  state     Json?
  summary   String?
  case      Case?               @relation(fields: [caseId], references: [id])
  caseId    String?
  call      Call?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([caseId])
}

// A voice session run by an AI agent: a phone call (Twilio) or a browser
// session. The transcript lives on the linked Conversation.
model Call {
  id             String        @id @default(cuid())
  ref            String        @unique // e.g. CALL-1001
  direction      CallDirection
  channel        CallChannel
  agentProfile   String // agent profile id, e.g. "inbound-hotline"
  status         CallStatus    @default(QUEUED)
  twilioCallSid  String?       @unique
  fromNumber     String?
  toNumber       String?
  language       String?
  startedAt      DateTime      @default(now())
  answeredAt     DateTime?
  endedAt        DateTime?
  durationSec    Int?
  // Structured result captured by the agent's tools (booking, hospital update, …)
  outcome        Json?
  summary        String?
  transferredTo  String?
  // Pairs the two legs of an interpreter bridge.
  bridgeId       String?
  // Operator who placed an outbound call.
  placedBy       String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  conversationId String?       @unique
  case           Case?         @relation(fields: [caseId], references: [id])
  caseId         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([caseId])
  @@index([status])
  @@index([bridgeId])
}

// The case timeline: everything that happened on a case, from any channel.
model CaseEvent {
  id        String        @id @default(cuid())
  case      Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId    String
  type      CaseEventType
  title     String
  body      String?
  data      Json?
  // "operator:elif", "agent:inbound-hotline", "system"
  actor     String?
  createdAt DateTime      @default(now())

  @@index([caseId, createdAt])
}

model KnowledgeDocument {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  category  String
  content   String
  createdAt DateTime @default(now())
}

// Travel insurance policy behind a patient's policy number: what is covered,
// limits and excess. Used by the hotline's coverage answers and by Letter of
// Guarantee decisions. Fictional demo data.
model Policy {
  id           String   @id @default(cuid())
  number       String   @unique
  patient      Patient? @relation(fields: [number], references: [policyNumber])
  plan         String // "Essential" | "Plus" | "Premier"
  validFrom    DateTime
  validTo      DateTime
  currency     String   @default("EUR")
  medicalLimit Decimal  @db.Decimal(12, 2)
  medicalUsed  Decimal  @default(0) @db.Decimal(12, 2)
  // Array of { code, label, covered, limit, unit, excess, waitingHours, conditions[] }
  benefits     Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// An e-mail or fax that arrived from outside (traveller, hospital, insurer),
// with the intake pipeline's results: matched case, risk flags, reply.
model InboundMessage {
  id              String            @id @default(cuid())
  ref             String            @unique // e.g. MSG-1001
  channel         MessageChannel
  externalId      String?           @unique // provider's message id (dedupe)
  fromAddress     String
  toAddress       String?
  subject         String?
  bodyText        String?
  receivedAt      DateTime          @default(now())
  status          InboundStatus     @default(RECEIVED)
  language        String?
  // Scored case match: { caseId, score, reasons[] } plus runners-up
  matchedCase     Case?             @relation(fields: [matchedCaseId], references: [id])
  matchedCaseId   String?
  matchConfidence Float?
  matchReasons    Json?
  // Why a human must look (complaint, legal, emergency, low confidence, …)
  riskFlags       String[]
  summary         String?
  error           String?
  documents       Document[]
  replies         OutboundMessage[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status])
  @@index([matchedCaseId])
}

// Everything the platform sends: e-mail replies, faxes, SMS.
model OutboundMessage {
  id                   String          @id @default(cuid())
  channel              MessageChannel
  toAddress            String
  subject              String?
  body                 String
  status               OutboundStatus  @default(QUEUED)
  provider             String? // "sendgrid" | "mock" | …
  providerMessageId    String?
  error                String?
  // true when sent without a human (auto-reply); false when approved by an operator
  automatic            Boolean         @default(true)
  approvedBy           String?
  attachmentDocumentId String?
  case                 Case?           @relation(fields: [caseId], references: [id])
  caseId               String?
  inReplyTo            InboundMessage? @relation(fields: [inReplyToId], references: [id])
  inReplyToId          String?
  sentAt               DateTime?
  createdAt            DateTime        @default(now())

  @@index([caseId])
  @@index([inReplyToId])
}

enum GuaranteeStatus {
  DRAFT // needs a human decision
  APPROVED
  SENT
  ACKNOWLEDGED // hospital confirmed receipt
  REJECTED
}

// Letter of Guarantee (payment guarantee) to a hospital, generated from its
// cost estimate. The amount is decided by rules against the policy — never
// by the language model — and every input is kept in decisionTrace.
model GuaranteeLetter {
  id                 String          @id @default(cuid())
  ref                String          @unique // e.g. LOG-1001
  case               Case            @relation(fields: [caseId], references: [id])
  caseId             String
  provider           Provider?       @relation(fields: [providerId], references: [id])
  providerId         String?
  hospitalName       String
  // The cost estimate this answers (a Document of kind COST_ESTIMATE)
  estimateDocumentId String?
  estimatedAmount    Decimal         @db.Decimal(12, 2)
  currency           String
  guaranteedAmount   Decimal         @db.Decimal(12, 2)
  excess             Decimal         @default(0) @db.Decimal(12, 2)
  conditions         String[]
  flags              String[] // why a human must decide (empty = auto-approvable)
  validUntil         DateTime
  status             GuaranteeStatus @default(DRAFT)
  approvedBy         String?
  rejectionReason    String?
  pdfDocumentId      String?
  sentVia            MessageChannel?
  sentTo             String?
  sentAt             DateTime?
  acknowledgedAt     DateTime?
  decisionTrace      Json
  billReviews        BillReview[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([caseId])
}

enum BillReviewStatus {
  PROPOSED // the AI's recommendation, not yet decided
  ACCEPTED // a person agreed: the recommended amount is what will be paid
  WAIVED // a person decided to pay as billed
}

// Line-by-line review of a hospital invoice or cost estimate against the
// reference tariff (src/lib/services/tariff.ts): billed vs recommended, with
// a reason for every change. The rules propose; a person accepts or waives.
model BillReview {
  id                String           @id @default(cuid())
  document          Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId        String           @unique
  case              Case?            @relation(fields: [caseId], references: [id], onDelete: SetNull)
  caseId            String?
  claim             Claim?           @relation(fields: [claimId], references: [id], onDelete: SetNull)
  claimId           String?
  // The guarantee this bill answers (a final invoice) or that answers it (an estimate)
  guaranteeLetter   GuaranteeLetter? @relation(fields: [guaranteeLetterId], references: [id], onDelete: SetNull)
  guaranteeLetterId String?
  kind              DocumentKind
  hospital          String?
  currency          String
  billed            Decimal          @db.Decimal(12, 2)
  recommended       Decimal          @db.Decimal(12, 2)
  savings           Decimal          @db.Decimal(12, 2)
  savingsEur        Decimal?         @db.Decimal(12, 2)
  // Lines with billed/recommended, findings with reasons, stay basis
  result            Json
  ruleset           String
  // Hash of the billed lines: a re-review keeps a person's decision while they are unchanged
  inputHash         String
  status            BillReviewStatus @default(PROPOSED)
  decidedBy         String?
  decidedAt         DateTime?
  // What the hospital agreed to pay-wise on a negotiation call; may differ
  // from the recommendation (a counter-offer within the agent's authority)
  agreedAmount      Decimal?         @db.Decimal(12, 2)
  // The call's result: outcome, hospital contact, hold-harmless, call ref
  agreement         Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([caseId])
  @@index([claimId])
  @@index([createdAt])
}

enum TransportMode {
  COMMERCIAL // scheduled flight, seated (wheelchair assistance if needed)
  COMMERCIAL_ESCORTED // scheduled flight with a nurse or doctor escort
  COMMERCIAL_STRETCHER // stretcher on a scheduled flight, with a medical escort
  AIR_AMBULANCE
  NOT_FIT_TO_FLY // stay and reassess
}

enum TransportStatus {
  ASSESSED
  QUOTES_REQUESTED
  BOOKED
  CANCELLED
}

// Repatriation / medical transport plan: what the treating doctor said
// (fitness to fly, mobility, oxygen, escort), the transport mode the rules
// recommend and a cost comparison of the options (src/lib/services/transport.ts).
model TransportPlan {
  id           String          @id @default(cuid())
  ref          String          @unique // e.g. MT-1001
  case         Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId       String
  callRef      String?
  assessment   Json
  mode         TransportMode
  reasons      String[]
  // Every mode with its indicative cost and whether it is medically suitable
  options      Json
  currency     String
  estimateLow  Decimal         @db.Decimal(12, 2)
  estimateHigh Decimal         @db.Decimal(12, 2)
  status       TransportStatus @default(ASSESSED)
  /// Operators' quotes for the recommended mode (src/lib/services/air-ambulance.ts): [{ id, operator, providerRef, accreditations, aircraft, crew, price, currency, etaHours, bedToBed, validUntil, receivedAt }]
  quotes       Json?
  /// The quote booked, and the mission's steps as they happen: { quoteId, steps: [{ code, label, at, done }] }
  mission      Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([caseId])
}

enum AssistantRole {
  USER
  ASSISTANT
}

enum AssistantMode {
  TEXT
  VOICE
}

// A conversation with the internal AI assistant, typed or spoken, kept for
// the operator who had it so they can come back to it.
model AssistantThread {
  id        String             @id @default(cuid())
  operator  String
  title     String
  messages  AssistantMessage[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([operator, updatedAt])
}

model AssistantMessage {
  id        String          @id @default(cuid())
  thread    AssistantThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId  String
  role      AssistantRole
  mode      AssistantMode   @default(TEXT)
  text      String
  // [{ title, source }] the answer was based on
  sources   Json?
  aiSource  String?
  // The voice session it was spoken in
  callRef   String?
  createdAt DateTime        @default(now())

  @@index([threadId, createdAt])
}

enum LeadStatus {
  NEW
  CONTACTED
  WON
  LOST
}

/// A quotation the presenter submitted, or a visitor's own details from the booth's QR page (/meet).
enum LeadSource {
  QUOTATION
  VISITOR
}

/// A quotation submitted from the business case. Unlike the rest of the
/// database this is a real prospect, not demo data: the seed never touches it.
model Lead {
  id              String     @id @default(cuid())
  ref             String     @unique
  quoteNumber     String
  customerName    String
  companyName     String
  email           String?
  phone           String?
  /// Everything the quotation was built from (BusinessCaseInput), so it can be shown and downloaded again.
  input           Json
  oneTimeTotal    Decimal    @db.Decimal(12, 2)
  monthlyCost     Decimal    @db.Decimal(12, 2)
  firstYearCost   Decimal    @db.Decimal(12, 2)
  netAnnualSaving Decimal    @db.Decimal(14, 2)
  status          LeadStatus @default(NEW)
  source          LeadSource @default(QUOTATION)
  /// What a visitor wrote on the QR page: their role and what they want to solve first.
  role            String?
  message         String?
  /// Meeting notes, kept with the quotation: who they are (LEAD_SEGMENTS), what hurts (LEAD_PAINS), the pilot chosen (src/lib/pilots.ts).
  segment         String?
  pains           String[]   @default([])
  pilot           String?
  notes           String?
  nextStep        String?
  nextStepOn      DateTime?  @db.Date
  followUpSentAt  DateTime?
  /// When they agreed to hear from us by e-mail, and who recorded it ("visitor": they ticked it on the QR page).
  contactConsentAt DateTime?
  contactConsentBy String?
  createdBy       String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  meetings        LeadMeeting[]

  @@index([createdAt])
  @@index([quoteNumber])
}

enum LeadMeetingStatus {
  SCHEDULED
  CANCELLED
}

/// A Teams call proposed to a lead (src/lib/services/lead-meetings.ts): the
/// invite went from the organiser's Microsoft 365 calendar, which stays the
/// source of truth for who accepted.
model LeadMeeting {
  id              String            @id @default(cuid())
  lead            Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId          String
  subject         String
  message         String
  startsAt        DateTime
  endsAt          DateTime
  /// The zone the time was proposed in (IANA), so it reads back as the customer was told.
  timeZone        String
  attendees       String[]
  /// The mailbox the invite came from.
  organizer       String
  provider        String // "graph" | "mock"
  providerEventId String
  joinUrl         String?
  webLink         String?
  /// The quotation's PDF went with the invite, in the same e-mail.
  withQuotation   Boolean           @default(false)
  status          LeadMeetingStatus @default(SCHEDULED)
  cancelledAt     DateTime?
  createdBy       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([leadId, startsAt])
}

enum ReceivableStatus {
  DRAFT
  SUBMITTED
  ACKNOWLEDGED
  APPROVED
  PARTIALLY_PAID
  PAID
  DISPUTED
}

/// An invoice a hospital or local correspondent sent to a foreign payer (an
/// assistance company or insurer), followed until it is paid: the receiving
/// side of a guarantee (src/lib/services/receivables.ts). Fictional demo data.
model Receivable {
  id            String           @id @default(cuid())
  ref           String           @unique // e.g. RCV-1001
  /// The hospital or correspondent that issued it.
  facility      String
  payerName     String
  payerEmail    String?
  payerPhone    String?
  payerCountry  String?
  patientName   String
  dateOfBirth   String?
  policyNumber  String?
  /// The payer's guarantee of payment this invoice answers, and its amount.
  gopRef        String?
  gopAmount     Decimal?         @db.Decimal(12, 2)
  invoiceNumber String
  diagnosis     String?
  serviceFrom   String?
  serviceTo     String?
  amount        Decimal          @db.Decimal(12, 2)
  currency      String
  paidAmount    Decimal          @default(0) @db.Decimal(12, 2)
  /// Charge rows: [{ code, description, quantity, unitPrice, amount }]
  lines         Json?
  /// Documents in the pack: ["Medical report (English)", "Discharge summary", …]
  attachments   String[]         @default([])
  status        ReceivableStatus @default(DRAFT)
  submittedAt   DateTime?
  dueAt         DateTime?
  paidAt        DateTime?
  /// The payer-ready check: { ready, checks: [{ label, ok, severity, fix }], expectedDeduction, cleanAmount, at }
  readiness     Json?
  /// Every chase: [{ at, channel: "EMAIL" | "PHONE", outcome, note, by, callRef }]
  chases        Json             @default("[]")
  /// The payer's answer on the last call: { status, expectedPaymentDate, approvedAmount, missing, payerRef, contact }
  payerAnswer   Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status])
  @@index([payerName])
}

enum PartnerKind {
  ASSISTANCE
  CORRESPONDENT
  INSURER
}

/// Another company in the network: a partner assistance company or local
/// correspondent we hand cases to (a federation member, a correspondent in a
/// resort region), or an assistance company that handles cases for an insurer.
model NetworkPartner {
  id          String         @id @default(cuid())
  ref         String         @unique // e.g. NP-01
  name        String
  kind        PartnerKind
  country     String
  /// Countries and regions it covers: ["Albania", "Kosovo", …]
  regions     String[]
  services    String[]
  languages   String[]
  email       String
  phone       String
  /// Turnaround it has agreed to: { firstResponseMinutes, gopHours, reportHours }
  sla         Json?
  createdAt   DateTime       @default(now())
  handoffs    CaseHandoff[]
  vendorCases Case[]         @relation("CaseVendor")
}

enum HandoffStatus {
  SENT
  ACCEPTED
  DECLINED
  IN_PROGRESS
  COMPLETED
}

/// A case handed to a partner: the pack sent, a secure link (the token) where
/// the partner accepts it and posts updates, and every update they sent.
model CaseHandoff {
  id          String         @id @default(cuid())
  ref         String         @unique // e.g. HO-1001
  case        Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId      String
  partner     NetworkPartner @relation(fields: [partnerId], references: [id])
  partnerId   String
  /// What we ask the partner to do: "Hospital visit and daily medical updates", …
  scope       String
  /// The pack as sent: summary, policy, guarantee, documents (names), instructions
  pack        Json
  token       String         @unique
  status      HandoffStatus  @default(SENT)
  /// Partner updates: [{ at, by, status, note, eta }]
  updates     Json           @default("[]")
  sentBy      String
  respondBy   DateTime
  acceptedAt  DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([caseId])
  @@index([partnerId])
}

/// Where the platform posts events (case updated, guarantee issued, call
/// completed, claim settled …), signed with the endpoint's secret.
model WebhookEndpoint {
  id         String            @id @default(cuid())
  url        String
  /// Events it receives: ["case.created", "guarantee.issued", …] or ["*"]
  events     String[]
  secret     String
  active     Boolean           @default(true)
  description String?
  createdBy  String?
  createdAt  DateTime          @default(now())
  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id         String          @id @default(cuid())
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  endpointId String
  event      String
  payload    Json
  statusCode Int?
  ok         Boolean         @default(false)
  error      String?
  durationMs Int?
  createdAt  DateTime        @default(now())

  @@index([endpointId, createdAt])
}
