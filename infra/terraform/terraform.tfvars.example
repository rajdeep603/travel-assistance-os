# Copy to terraform.tfvars and adjust. terraform.tfvars is git-ignored.

# REQUIRED — where the instance clones the application from on first boot.
# Must be reachable from the instance (public repo, or embed a read-only token).
repo_url = "https://github.com/<your-org>/travel-assistance-os.git"

aws_region    = "eu-central-1"

# Which AWS account/profile to deploy into. Pinning both here means a wrong
# AWS_PROFILE in your shell can never apply to the wrong account:
#   aws configure list-profiles                  # available profiles
#   aws sts get-caller-identity --profile <p>    # account ID of a profile
aws_profile        = ""   # e.g. "personal-cloud"
allowed_account_id = ""   # e.g. "123456789012"
instance_type = "t3.small"
repo_branch   = "main"

# SSH access (optional — omit both to use SSM Session Manager instead):
# ssh-keygen -t ed25519 -f ~/.ssh/taap-demo && cat ~/.ssh/taap-demo.pub
ssh_public_key   = ""
allowed_ssh_cidr = "" # your IP, e.g. "203.0.113.7/32"

# HTTPS (required for the browser microphone and Twilio voice):
enable_https_port = true
domain_name       = ""   # e.g. "demo.example.com"
letsencrypt_email = ""   # expiry notices from Let's Encrypt
route53_zone_id   = ""   # set to manage the A record here; else create it at your registrar

# Off-host nightly database backups (optional):
backup_bucket_name = ""  # e.g. "taap-demo-backups-<random>"
