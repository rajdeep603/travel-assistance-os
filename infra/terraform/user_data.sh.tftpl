#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# First-boot bootstrap for the Travel Assistance AI Platform demo host.
# Logs to /var/log/taap-bootstrap.log — check it if anything looks off:
#   sudo tail -f /var/log/taap-bootstrap.log
# ---------------------------------------------------------------------------
set -euo pipefail
exec > >(tee -a /var/log/taap-bootstrap.log) 2>&1

echo "[bootstrap] $(date -Is) starting"

# --- 1. Swap (protects small instances during the Docker build) -------------
if [ ! -f /swapfile ]; then
  fallocate -l 2G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

# --- 2. Docker + Compose plugin + git ---------------------------------------
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y ca-certificates curl git
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] \
  https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) stable" \
  > /etc/apt/sources.list.d/docker.list
apt-get update
apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
usermod -aG docker ubuntu

# --- 3. Clone the repository -------------------------------------------------
APP_DIR="${app_dir}"
if [ ! -d "$APP_DIR/.git" ]; then
  sudo -u ubuntu git clone --branch "${repo_branch}" "${repo_url}" "$APP_DIR"
fi

# --- 4. Generate .env ON the instance (secrets never leave this machine) ----
PUBLIC_IP="$(curl -fsS -H "X-aws-ec2-metadata-token: $(curl -fsS -X PUT \
  -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' http://169.254.169.254/latest/api/token)" \
  http://169.254.169.254/latest/meta-data/public-ipv4 || echo localhost)"

if [ ! -f "$APP_DIR/.env" ]; then
  DB_PASSWORD="$(openssl rand -hex 24)"
  cat > "$APP_DIR/.env" <<ENV
# Generated by cloud-init on first boot — edit and re-run
# 'docker compose up -d' to apply changes.
POSTGRES_USER=taap
POSTGRES_PASSWORD=$DB_PASSWORD
POSTGRES_DB=taap
NEXT_PUBLIC_APP_URL=http://$PUBLIC_IP
AI_API_KEY=
AI_MODEL=claude-haiku-4-5
MAX_UPLOAD_MB=10
AUTO_SEED=true
HTTP_PORT=80
ENV
  chown ubuntu:ubuntu "$APP_DIR/.env"
  chmod 600 "$APP_DIR/.env"
fi

# --- 5. Build and start the stack (migrations + seed run in the entrypoint) --
cd "$APP_DIR"
docker compose up -d --build

# --- 6. Health gate -----------------------------------------------------------
for i in $(seq 1 40); do
  if curl -fsS http://localhost/api/health | grep -q '"status":"ok"'; then
    echo "[bootstrap] $(date -Is) SUCCESS — http://$PUBLIC_IP is serving and healthy"
    exit 0
  fi
  sleep 10
done

echo "[bootstrap] $(date -Is) FAILED — health check never passed. Recent app logs:"
docker compose logs --tail 80 app
exit 1
